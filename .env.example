# Copy this file to .env and fill in real values. .env is git-ignored; never commit it.

# API key for the class LLM proxy (OpenAI-compatible).
OPENAI_API_KEY=

# Base URL of the class proxy, e.g. https://<proxy-host>/v1
OPENAI_BASE_URL=

# Optional: GitHub personal access token for scripts/fetch_corpus.py.
# Without it the GitHub API allows only 60 requests/hour. Read-only public scope is enough.
GITHUB_TOKEN=
